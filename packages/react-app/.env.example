# Network Configuration
# For local Anvil development:
REACT_APP_CHAIN_ID=31337
REACT_APP_NETWORK_NAME=anvil-local
REACT_APP_RPC_URL=http://localhost:8545

# For Base Sepolia testnet:
# REACT_APP_CHAIN_ID=84532
# REACT_APP_NETWORK_NAME=base-sepolia
# REACT_APP_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# For Base mainnet:
# REACT_APP_CHAIN_ID=8453
# REACT_APP_NETWORK_NAME=base
# REACT_APP_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Backend Server URL (REQUIRED for non-local deployments)
# This is the V3 API server that handles pixel data, ownership, etc.
REACT_APP_SERVER_URL=http://localhost:3003

# L1 API URL (optional - defaults to https://api.ownthedoge.com)
# This is the Ethereum mainnet API for legacy pixel data
# REACT_APP_L1_API_URL=https://api.ownthedoge.com

# API Keys
REACT_APP_ALCHEMY_ID=your_alchemy_key
REACT_APP_WALLETCONNECT_PROJECTID=your_walletconnect_project_id

# Environment
NODE_ENV=development
REACT_APP_DOG_ENV=development

# Optional: Override contract addresses (auto-detected from abi.json if not set)
# REACT_APP_PX_CONTRACT=0x...
# REACT_APP_DOG20_CONTRACT=0x...

# Optional: Provider URL (alternative to RPC_URL, used for read-only operations)
# REACT_APP_PROVIDER=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: Sentry error tracking
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn
