# PX Token Deployment Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Your private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Required: RPC URL for the network you want to deploy to
# Examples:
# Ethereum Mainnet: https://eth-mainnet.alchemyapi.io/v2/YOUR_API_KEY
# Ethereum Sepolia: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Base Mainnet: https://mainnet.base.org
# Base Sepolia: https://sepolia.base.org
# Local Foundry: http://localhost:8545
RPC_URL=your_rpc_url_here

# Optional: Etherscan API key for contract verification
# Get from: https://etherscan.io/apis (or respective block explorer)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: Gas price settings (in gwei)
# GAS_PRICE=20

# Optional: Gas limit
# GAS_LIMIT=2000000