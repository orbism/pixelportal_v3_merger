# - ALCHEMY_KEY=your_key_here (optional for local)


# Below are minimum requirements for local runs
# Server
PORT=3003
APP_ENV=development

# Database (your running Postgres container)
DATABASE_URL=postgresql://dbusername:dbpassword@localhost:15432/dbname?schema=public
POSTGRES_USER=dbusername
POSTGRES_PASSWORD=dbpassword
POSTGRES_DB=dbname

# Redis (your running Redis container)
REDIS_URL=redis://:redispassword@localhost:19779
REDIS_PORT=19779
REDIS_PASSWORD=redispassword

# Blockchain - CHANGE TO LOCAL ANVIL FOR LOCAL DEVELOPMENT 
# TODO: CB is coinbase api; switch out entirely to alchemy + etherscan api
CB_WS_ENDPOINT=ws://localhost:8545
CB_HTTP_ENDPOINT=http://localhost:8545
CB_PROJECT_ID=local
CB_SECRET=local

# Alchemy (reminder: ENS disabled on Base)
ALCHEMY_KEY=your_alchemy_key

# Local deployment (IMPORTANT: SET TO DEPLOY BLOCK NUMBER so server knows where to start syncing from)
CONTRACT_BLOCK_NUMBER_DEPLOYMENT=0

# RPC Rate Limiting (Alchemy free tier: 500 CUPs, eth_getLogs = 75 CUs)
# Default 500ms = 2 req/sec, conservative for free tier. Decrease for paid plans.
# RPC_RATE_LIMIT_DELAY_MS=500

# Alchemy free tier limits eth_getLogs to 10 block range. Paid plans can use ~2000.
# RPC_BLOCK_RANGE_LIMIT=10

# Free Money - blank key to disable
DRIP_KEY=

# Discord connectivity
DISCORD_ENABLED=false
DISCORD_SECRET=discord_secret
DISCORD_CHANNEL_ID=channel_id

# Email
SMTP_HOST="smtp.service.com"
SMTP_PORT=587
SMTP_USER="the@email.user"
SMTP_PASS="password"
SMTP_FROM="Pixel Portal <the@email.sender>"
SUPPORT_EMAIL_RECIPIENTS="suffering@support.people"