# Edit it - minimum required for local:
# - PORT=3000
# - APP_ENV=development
# - DATABASE_URL=postgresql://dogepixels:dogepixels@localhost:15432/dogepixels?schema=public
# - POSTGRES_USER=dogepixels
# - POSTGRES_PASSWORD=dogepixels
# - POSTGRES_DB=dogepixels
# - REDIS_URL=redis://:redis_password@localhost:16379
# - REDIS_PORT=16379
# - REDIS_PASSWORD=redis_password
# - CB_WS_ENDPOINT=ws://localhost:8545
# - CB_HTTP_ENDPOINT=http://localhost:8545
# - ALCHEMY_KEY=your_key_here (optional for local)


# Below are minimum requirements for local runs
# Server
PORT=3003
APP_ENV=development

# Database (your running Postgres container)
DATABASE_URL=postgresql://dbusername:dbpassword@localhost:15432/dbname?schema=public
POSTGRES_USER=dbusername
POSTGRES_PASSWORD=dbpassword
POSTGRES_DB=dbname

# Redis (your running Redis container)
REDIS_URL=redis://:redispassword@localhost:19779
REDIS_PORT=19779
REDIS_PASSWORD=redispassword

# V3 Contract Network Configuration
# These RPC endpoints determine which network the V3 contract runs on.
# The V3 contract address is auto-resolved from abi.json based on the chain ID.
# Examples:
#   Local Anvil:    ws://localhost:8545 / http://localhost:8545
#   Base Sepolia:   wss://base-sepolia.g.alchemy.com/v2/KEY / https://base-sepolia.g.alchemy.com/v2/KEY
#   Base Mainnet:   wss://base-mainnet.g.alchemy.com/v2/KEY / https://base-mainnet.g.alchemy.com/v2/KEY
CB_WS_ENDPOINT=ws://localhost:8545
CB_HTTP_ENDPOINT=http://localhost:8545
CB_PROJECT_ID=local
CB_SECRET=local

# Alchemy API Key (used for burn verification on legacy contracts)
# This key is used to construct RPC URLs for checking burns on:
#   - Ethereum mainnet: V1 contract (hardcoded: 0xBAac2B4491727D78D2b78815144570b9f2Fe8899)
#   - Base mainnet: V2 contract (hardcoded: 0xAfb89a09D82FBDE58f18Ac6437B3fC81724e4dF6)
#   - Base Sepolia: V2 testnet contract (address read from abi.json)
# Note: ENS resolution is disabled on Base networks
ALCHEMY_KEY=your_alchemy_key

# Local deployment (IMPORTANT: SET TO DEPLOY BLOCK NUMBER so server knows where to start syncing from)
CONTRACT_BLOCK_NUMBER_DEPLOYMENT=0

# RPC Rate Limiting (Alchemy free tier: 500 CUPs, eth_getLogs = 75 CUs)
# Default 500ms = 2 req/sec, conservative for free tier. Decrease for paid plans.
# RPC_RATE_LIMIT_DELAY_MS=500

# Alchemy free tier limits eth_getLogs to 10 block range. Paid plans can use ~2000.
# RPC_BLOCK_RANGE_LIMIT=10

# Free Money faucet - blank key to disable
# This wallet sends DOG tokens to users who sign a message
DRIP_KEY=

# Burn Verification Admin Key (required for migration)
# Private key of wallet with ADMIN_ROLE on V3 contract
# Used to call setBurnFlags() and reserveTokensForMigration() on V3
# This is separate from DRIP_KEY to avoid enabling the FreeMoney faucet
BURN_VERIFICATION_KEY=

# Discord connectivity
DISCORD_ENABLED=false
DISCORD_SECRET=discord_secret
DISCORD_CHANNEL_ID=channel_id

# Email
SMTP_HOST="smtp.service.com"
SMTP_PORT=587
SMTP_USER="the@email.user"
SMTP_PASS="password"
SMTP_FROM="Pixel Portal <the@email.sender>"
SUPPORT_EMAIL_RECIPIENTS="suffering@support.people"